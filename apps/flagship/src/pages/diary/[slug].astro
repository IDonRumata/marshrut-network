---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Container from '../../components/Container.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const entries = await getCollection('diary');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const dateStr = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }).format(entry.data.publishedAt);
---
<Base
  title={`${entry.data.title} - Дневник Маршрут`}
  description={entry.data.seo?.description ?? entry.body?.slice(0, 160) ?? ''}
  ogType="article"
>
  <Header />
  <main>
    <Container size="narrow">
      <header class="entry-header">
        <a href="/diary/" class="back">← Все записи</a>
        <h1>{entry.data.title}</h1>
        <div class="meta">
          <time>{dateStr}</time>
          {entry.data.location && <><span>·</span><span>{entry.data.location}</span></>}
          {entry.data.mood && <><span>·</span><span class="mood">{entry.data.mood}</span></>}
        </div>
      </header>
      <article class="entry-body">
        <Content />
      </article>
    </Container>
  </main>
  <Footer />
</Base>

<style>
  .entry-header {
    padding: var(--space-6) 0 var(--space-4);
    border-bottom: 1px solid var(--color-mile);
    margin-bottom: var(--space-6);
  }
  .back {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-sm);
    color: var(--color-smoke);
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--space-3);
  }
  .back:hover { color: var(--color-headlight); opacity: 1; }
  h1 {
    font-family: var(--font-family-heading);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.2;
    margin-bottom: var(--space-2);
  }
  .meta {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-sm);
    color: var(--color-smoke);
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }
  .meta time { color: var(--color-headlight); }
  .mood { font-style: italic; }
  .entry-body {
    font-family: var(--font-family-body);
    font-size: var(--font-size-lg);
    line-height: 1.7;
    color: var(--color-ink);
    padding-bottom: var(--space-8);
  }
  .entry-body :global(p) { margin-bottom: var(--space-3); }
</style>
