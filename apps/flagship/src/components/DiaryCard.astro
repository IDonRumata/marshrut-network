---
interface Props {
  title: string;
  href: string;
  location?: string;
  publishedAt: Date;
  excerpt: string;
}
const { title, href, location, publishedAt, excerpt } = Astro.props;
const dateStr = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'short' }).format(publishedAt);
---
<a class="diary" href={href}>
  <div class="date-col">
    <time>{dateStr}</time>
    {location && <span class="location">{location}</span>}
  </div>
  <div class="text-col">
    <h3>{title}</h3>
    <p>{excerpt}</p>
  </div>
</a>

<style>
  .diary {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-mile);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s, padding 0.15s;
  }
  .diary:hover {
    background: rgba(233, 69, 96, 0.04);
    padding-inline: var(--space-2);
    margin-inline: calc(-1 * var(--space-2));
    border-radius: var(--radius-md);
    border-bottom-color: transparent;
    opacity: 1;
  }
  @media (min-width: 768px) {
    .diary { grid-template-columns: 140px 1fr; gap: var(--space-4); }
  }
  .date-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--font-family-mono);
    font-size: var(--font-size-sm);
    color: var(--color-smoke);
  }
  .date-col time { color: var(--color-headlight); font-weight: var(--font-weight-bold); }
  .location { font-size: var(--font-size-xs); }
  h3 {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-ink);
    margin-bottom: var(--space-1);
    line-height: 1.3;
  }
  p {
    color: var(--color-smoke);
    font-size: var(--font-size-base);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
