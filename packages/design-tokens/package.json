{
  "name": "@marshrut/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design tokens for Marshrut network: colors, typography, spacing, radii. Source of truth synced with Figma.",
  "main": "./dist/tokens.json",
  "exports": {
    ".": "./dist/tokens.json",
    "./css": "./dist/tokens.css",
    "./json": "./dist/tokens.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', {recursive: true, force: true}))\""
  }
}
