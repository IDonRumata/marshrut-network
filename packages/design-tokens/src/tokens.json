{
  "$schema": "./schema.json",
  "meta": {
    "name": "Marshrut Design Tokens",
    "version": "0.1.0",
    "description": "Дорожный журнал современного номада — честный, немного суровый, но с душой"
  },
  "color": {
    "ink":       { "value": "#1A1A2E", "description": "Основной текст, тёмный фон" },
