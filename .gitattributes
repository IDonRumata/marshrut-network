# Auto-detect text files and normalize line endings to LF in repo
* text=auto eol=lf

# Force LF for source files
*.js   text eol=lf
*.ts   text eol=lf
*.jsx  text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.sh   text eol=lf

# Windows-specific
*.ps1  text eol=crlf
*.bat  text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff2 binary
*.pdf binary
