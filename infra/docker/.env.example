# ============================================================
# Пример переменных окружения для docker-compose
# Скопируй в .env и заполни:
#   cp .env.example .env
#   nano .env
# ============================================================

# --- Caddy / ACME ---
# Email для Let's Encrypt уведомлений (просрочка сертификата и т.п.)
ACME_EMAIL=andrey@example.com

# Домены — после регистрации marshrut.eu вписать сюда
SITE_DOMAIN=marshrut.eu
SITE_DOMAIN_WWW=www.marshrut.eu

# --- Listmonk БД ---
# Пользователь и пароль для PostgreSQL Listmonk
# Пароль сгенерируй: openssl rand -base64 32
LISTMONK_DB_USER=listmonk
LISTMONK_DB_PASSWORD=__REPLACE_ME__
LISTMONK_DB_NAME=listmonk

# --- Plausible (опционально, профиль analytics) ---
# Секрет для шифрования сессий — openssl rand -base64 48
PLAUSIBLE_SECRET_KEY=__REPLACE_ME__
PLAUSIBLE_DB_USER=plausible
PLAUSIBLE_DB_PASSWORD=__REPLACE_ME__
